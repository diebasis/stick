-      ctx.fillStyle = '#071122';
-      ctx.strokeStyle = this.theme.bone;
-      ctx.lineWidth = Math.max(3.5, 3.5 * scale);
-
-      for (const key of ['handL', 'handR']) {
-        const p = joints[key];
-        ctx.beginPath();
-        ctx.arc(p.x, p.y, 7.5 * scale, 0, TAU);
-        ctx.fill();
-        ctx.stroke();
